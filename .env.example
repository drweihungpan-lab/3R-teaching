# Optional backend settings. Copy to .env in the repo root; never commit .env.
# Actual environment variables take precedence over this file.
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=5242880

# Frontend: the API base address, without /process. Restart after changing.
# Later Compose networking uses http://backend:8000 instead of localhost.
BACKEND_URL=http://127.0.0.1:8000
# Positive seconds for HTTP connection/read inactivity (not a total runtime limit).
REQUEST_TIMEOUT=30
